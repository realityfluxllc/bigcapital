# Environment for docker-compose.metis.yml (Metis / RealityFlux deployment).
# Copy to `.env` next to the compose file and fill in the secrets.
#
# Only the variables the Metis compose needs or that differ from .env.example
# are listed here; anything else from .env.example (mail, Plaid, Stripe, New
# Relic, throttling, ...) can be appended as needed.

# ---- Required (compose refuses to start without these) ----------------------
# openssl rand -base64 48
APP_JWT_SECRET=
# Public URL served by Traefik, e.g. https://books.example.com (no trailing slash)
BASE_URL=
# openssl rand -base64 32
DB_ROOT_PASSWORD=
# openssl rand -base64 32  (ClickHouse is off by default but the container still starts)
CLICKHOUSE_PASSWORD=
# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# ---- Host wiring -------------------------------------------------------------
# Only port published on the host; Traefik proxies to 127.0.0.1:${PUBLIC_PROXY_PORT}.
PUBLIC_PROXY_PORT=8085
# Bind-mount root for mysql/, redis/, garage/, clickhouse/ (TrueNAS appdata, snapshotted).
BIGCAPITAL_DATA_DIR=/mnt/Scriptorium/appdata/bigcapital

# ---- Database ----------------------------------------------------------------
DB_USER=bigcapital
DB_PASSWORD=
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_system
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# ---- Bank feeds --------------------------------------------------------------
# Master switch for the "Connect bank / credit card" UI (Plaid and/or SimpleFIN).
BANK_FEED_ENABLED=true
# SimpleFIN needs no server credentials: users paste a setup token in the app.
SIMPLEFIN_ENABLED=true
SIMPLEFIN_SYNC_INTERVAL_HOURS=12
SIMPLEFIN_INITIAL_SYNC_DAYS=90
# Leave Plaid empty to hide it (it is only enabled when both ID and secret are set).
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=
PLAID_CLIENT_NAME=

# ---- Sign-up -----------------------------------------------------------------
# Set to true after creating the first account to stop public sign-ups.
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# ---- PDF generation (in-network Gotenberg) ------------------------------------
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_DOCS_URL=http://server:3000/public/

# ---- Attachments: Garage S3 ----------------------------------------------------
# After first `up`, bootstrap the bucket + key once:
#   docker compose -f docker-compose.metis.yml exec garage bash /garage-setup/setup.sh
# then paste the printed key id/secret here and restart `server`.
S3_REGION=garage
S3_ENDPOINT=http://garage:3900
S3_BUCKET=bigcapital
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Analytics (optional) -------------------------------------------------------
CLICKHOUSE_ENABLED=false
CLICKHOUSE_USER=default
CLICKHOUSE_DATABASE=bigcapital_analytics

# ---- Exchange rates (optional) --------------------------------------------------
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=

# ---- Mail (optional) ---------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Bigcapital
MAIL_FROM_ADDRESS=
